{
  "name": "chembalance",
  "description": "TypeScript library for balancing chemical reaction equations using stoichiometric methods.",
  "license": "MIT",
  "version": "1.0.0",
  "author": {
    "name": "komed3 (Paul Köhler)",
    "email": "webmaster@komed3.de",
    "url": "https://komed3.de"
  },
  "homepage": "https://komed3.github.io/chemistry",
  "keywords": [
    "chemistry",
    "chemical-equations",
    "chemical-reactions",
    "equation-balancing",
    "reaction-balancing",
    "stoichiometry",
    "linear-algebra",
    "chemical-equation-balancer",
    "chemparse",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komed3/chembalance.git"
  },
  "bugs": {
    "url": "https://github.com/komed3/chembalance/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/types/index.d.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:dts": "tsc -p tsconfig.dts.json",
    "build:all": "npm run build:cjs && npm run build:esm && npm run build:dts",
    "format": "prettier --ignore-path \"\" --write \"./dist/**/*\" --log-level warn",
    "build": "npm run clean && npm run build:all && npm run format",
    "postbuild": "tsc-alias && node scripts/postbuild.mjs",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "chemparse": "^1.2.1"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "tsc-alias": "^1.9.10",
    "typescript": "^7.0.2"
  }
}
